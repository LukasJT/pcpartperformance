{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pcpartperformance-live",
  "main": "scripts/worker.mjs",
  "compatibility_date": "2026-10-05",
  "triggers": { "crons": ["0 11,12 * * *"] },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "404-page"
  }
}
