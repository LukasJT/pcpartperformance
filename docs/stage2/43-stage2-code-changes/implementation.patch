+// Optional Node HTTP adapter. The Sites static deployment serves downloadable JSON only.
+const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');
+module.exports=function createAPI({root,limit=60,windowMs=60000,now=Date.now}){const files=new Map([['/api/v1/catalog-coverage','catalog-coverage.json'],['/api/v1/phones','phones.json']]),clients=new Map(),cache=new Map();return function(req,res){let pathname;try{pathname=new URL(req.url,'http://local').pathname}catch{res.writeHead(400);res.end();return true}if(!pathname.startsWith('/api/v1/'))return false;const file=files.get(pathname);if(!file){res.writeHead(404,{'Content-Type':'application/json'});res.end('{"error":"unknown_dataset"}');return true}if(!['GET','HEAD'].includes(req.method)){res.writeHead(405,{'Allow':'GET, HEAD'});res.end();return true}const time=now(),ip=req.socket.remoteAddress||'unknown';for(const [key,v]of clients)if(time-v.start>=windowMs)clients.delete(key);let client=clients.get(ip);if(!client){if(clients.size>=10000){res.writeHead(503);res.end();return true}client={start:time,count:0};clients.set(ip,client)}if(++client.count>limit){res.writeHead(429,{'Retry-After':String(Math.ceil((windowMs-time+client.start)/1000)),'Cache-Control':'no-store'});res.end('{"error":"rate_limit"}');return true}let data=cache.get(file);if(!data||time-data.loaded>15*60e3){try{const body=fs.readFileSync(path.join(root,'api/v1',file));data={body,loaded:time,etag:'"'+crypto.createHash('sha256').update(body).digest('hex')+'"'};cache.set(file,data)}catch{res.writeHead(503,{'Cache-Control':'no-store'});res.end('{"error":"dataset_unavailable"}');return true}}const headers={'Content-Type':'application/json; charset=utf-8','Cache-Control':'public, max-age=300','ETag':data.etag,'X-Content-Type-Options':'nosniff'};if(req.headers['if-none-match']===data.etag){res.writeHead(304,headers);res.end();return true}res.writeHead(200,headers);res.end(req.method==='HEAD'?undefined:data.body);return true}}
diff --git a/scripts/publication-content.cjs b/scripts/publication-content.cjs
new file mode 100644
index 0000000..784b88f
--- /dev/null
