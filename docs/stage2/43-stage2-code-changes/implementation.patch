+function eligible(a,now=Date.now()) {const date=Date.parse(a.datePublished);return a.type==='news'&&a.status==='published'&&a.editorApproved===true&&a.confirmedDeployment===true&&Array.isArray(a.sourceIds)&&a.sourceIds.length>0&&Number.isFinite(date)&&date<=now&&now-date<=48*3600e3&&/^news\/[a-z0-9-]+$/.test(a.route)}
