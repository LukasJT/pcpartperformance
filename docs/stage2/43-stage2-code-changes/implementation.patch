+const fs=require('node:fs'),path=require('node:path'),crypto=require('node:crypto');
+const {pages}=require('./publication-content.cjs'),sources=require('./publication-sources.cjs'),phones=require('./phone-data.cjs'),tools=require('./planning-tools.cjs'),{newsSitemap,xml}=require('./news-policy.cjs');
+const date='2026-10-04',domain='https://www.pcpartperformance.com';
+module.exports=({root,records,images,groups,shell,write,esc})=>{
+ const mkdir=dir=>fs.mkdirSync(path.join(root,dir),{recursive:true}),json=(file,value)=>{mkdir(path.dirname(file));fs.writeFileSync(path.join(root,file),JSON.stringify(value,null,2))},update=(route,fn)=>{const f=path.join(root,route,'index.html');fs.writeFileSync(f,fn(fs.readFileSync(f,'utf8')))};
+ const nav='<nav class="publication-nav" aria-label="Explore resources"><a href="/blog/">Guides</a><a href="/news/">Newsroom</a><a href="/phones/">Phones</a><a href="/tools/">Tools</a><a href="/data/">Data</a><a href="/search/">Search</a><a href="/saved/">Saved</a></nav>';
+ const script='<script src="/planning-math.js" defer></script><script src="/publication-ui.js" defer></script>',metadata={},search=[];
+ const structured=data=>'<script type="application/ld+json">'+JSON.stringify({'@context':'https://schema.org',...data}).replace(/</g,'\\u003c')+'</script>';
+ const image=(id,title)=>`<img class="publication-hero" src="/assets/publication/${id}.png" width="1200" height="675" alt="${esc(title)}" decoding="async">`;
+ const actions=id=>`<div class="publication-actions"><button class="button secondary" type="button" data-save-id="${esc(id)}" aria-pressed="false">Save to your list</button><a class="button secondary" href="/saved/">Your saved list</a></div><p class="saved-status" data-saved-status aria-live="polite"></p>`;
+ const cite=ids=>`<p class="publication-source">Source: ${ids.map(id=>`<a href="${esc(sources[id].url)}" target="_blank" rel="noopener noreferrer">${esc(sources[id].publisher+' — '+sources[id].title)}</a>`).join('; ')}.</p>`;
+ const sourceList=ids=>`<section id="sources"><h2>Evidence and updates</h2><p>Sources checked October 4, 2026. Manufacturer statements are specifications, not our measurements. Material corrections appear in the <a href="/data/changelog/">data changelog</a>.</p><ul>${[...new Set(ids)].map(id=>`<li><a href="${esc(sources[id].url)}" target="_blank" rel="noopener noreferrer">${esc(sources[id].title)}</a> — ${esc(sources[id].scope)}</li>`).join('')}</ul><p><a href="/editorial-policy/#corrections">Report a correction</a> · <a href="/data/sources/">Source registry</a></p></section>`;
+ function page(route,title,description,body,{id,kind='resource',imageId=null,noindex=false,aliases=[]}={}){const doc=shell(title,'guide',nav+body+structured({'@type':'WebPage',name:title,description,url:domain+'/'+route+'/'}),{description,active:route.startsWith('blog')?'learn':route.split('/')[0]});write(route,doc.replace('</head>','<link rel="stylesheet" href="/publication.css">'+script+'</head>').replace('<body ',`<body ${noindex?'data-stage2-noindex ':''}data-publication `));metadata['/'+route+'/']={title,description,image:imageId?{src:'/assets/publication/'+imageId+'.png',alt:title}:null,noindex,datePrepared:date,datePublished:null};if(id)search.push({id,title,url:'/'+route+'/',kind,aliases})}
+ const card=(title,url,description,imageId)=>`<article class="publication-card">${imageId?`<a href="${url}" tabindex="-1" aria-hidden="true"><img src="/assets/publication/${imageId}.png" width="1200" height="675" alt="" loading="lazy" decoding="async"></a>`:''}<div><h3><a href="${url}">${esc(title)}</a></h3><p>${esc(description)}</p></div></article>`;
+ const heading=(title,description)=>`<header class="article-header"><h1>${esc(title)}</h1><p>${esc(description)}</p></header>`;
+ const currency='<label>Budget currency (no conversion)<select name="currency"><option value="CAD">CAD</option><option value="USD">USD</option></select></label>';
