+function queueEntry({source,title,url,sourcePublishedAt},now=new Date().toISOString()){const u=new URL(url);if(u.protocol!=='https:'||u.username||u.password)throw Error('Unsafe source URL');if(!title.trim())throw Error('Missing title');return{id:crypto.createHash('sha256').update(source+'\0'+u.href).digest('hex').slice(0,24),source,title:title.slice(0,500),url:u.href,sourcePublishedAt:sourcePublishedAt&&Number.isFinite(Date.parse(sourcePublishedAt))?new Date(sourcePublishedAt).toISOString():null,firstSeen:now,status:'needs-review',editorApproved:false,confirmedDeployment:false,datePublished:null}}
+function newsArticle(a){const now=Date.now();if(!eligible({...a,datePublished:new Date(now).toISOString()},now))throw Error('News is not approved and confirmed published');const published=Date.parse(a.datePublished),modified=Date.parse(a.dateModified);if(!Number.isFinite(published)||published>now)throw Error('Missing or future first publication date');if(a.dateModified&&(!Number.isFinite(modified)||modified<published||modified>now))throw Error('Invalid material revision date');return{'@context':'https://schema.org','@type':'NewsArticle',headline:a.title,datePublished:a.datePublished,...(a.dateModified?{dateModified:a.dateModified}:{}),url:domain+'/'+a.route+'/',author:{'@type':'Organization',name:'PC Part Performance',url:domain+'/about/'},publisher:{'@type':'Organization',name:'PC Part Performance',url:domain+'/about/'}}}
